@model Reservation
@{ ViewData["Title"] = "Đặt trước sách"; }
<h2>Đặt trước sách</h2>
<form method="post" asp-action="Reserve">
    <div class="mb-2"><label asp-for="ReaderId"></label><select asp-for="ReaderId" asp-items="ViewBag.ReaderId" class="form-select"></select></div>
    <div class="mb-2"><label asp-for="BookId"></label><select asp-for="BookId" asp-items="ViewBag.BookId" class="form-select"></select></div>
    <button class="btn btn-primary" type="submit">Đặt trước</button>
</form>
