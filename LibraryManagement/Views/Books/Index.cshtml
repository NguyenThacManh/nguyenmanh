@model BooksIndexViewModel
@{
    ViewData["Title"] = "Danh sách sách";
}

<div class="page-header d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">Danh sách sách</h2>
        <p class="text-muted mb-0">Tìm kiếm nhanh, lọc theo thể loại và sắp xếp linh hoạt.</p>
    </div>
    <a class="btn btn-success" asp-action="Create">+ Thêm sách mới</a>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-lg-4">
                <label class="form-label">Từ khóa</label>
                <input
                    type="text"
                    name="searchTerm"
                    value="@Model.SearchTerm"
                    class="form-control"
                    placeholder="Tên sách hoặc tác giả..." />
            </div>

            <div class="col-lg-3">
                <label class="form-label">Thể loại</label>
                <select name="category" class="form-select">
                    <option value="">-- Tất cả thể loại --</option>
                    @foreach (var c in Model.Categories)
                    {
                        <option value="@c" selected="@(Model.Category == c)">@c</option>
                    }
                </select>
            </div>

            <div class="col-lg-2">
                <label class="form-label">Sắp xếp</label>
                <select name="sortBy" class="form-select">
                    <option value="title_asc" selected="@(Model.SortBy == "title_asc")">Tên A → Z</option>
                    <option value="title_desc" selected="@(Model.SortBy == "title_desc")">Tên Z → A</option>
                    <option value="author_asc" selected="@(Model.SortBy == "author_asc")">Tác giả A → Z</option>
                    <option value="author_desc" selected="@(Model.SortBy == "author_desc")">Tác giả Z → A</option>
                    <option value="year_desc" selected="@(Model.SortBy == "year_desc")">Năm mới nhất</option>
                    <option value="year_asc" selected="@(Model.SortBy == "year_asc")">Năm cũ nhất</option>
                </select>
            </div>

            <div class="col-lg-2">
                <label class="form-label">Hiển thị</label>
                <select name="pageSize" class="form-select">
                    <option value="6" selected="@(Model.PageSize == 6)">6 / trang</option>
                    <option value="12" selected="@(Model.PageSize == 12)">12 / trang</option>
                    <option value="24" selected="@(Model.PageSize == 24)">24 / trang</option>
                </select>
            </div>

            <div class="col-lg-1 d-grid">
                <button type="submit" class="btn btn-primary">Lọc</button>
            </div>

            <div class="col-12">
                <a asp-action="Index" class="btn btn-link px-0">Xóa bộ lọc</a>
            </div>
        </form>
    </div>
</div>

<p class="text-muted">Hiển thị <strong>@Model.StartItem - @Model.EndItem</strong> trên <strong>@Model.TotalItems</strong> kết quả.</p>

<div class="table-responsive rounded-3 shadow-sm bg-white">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Tên sách</th>
                <th>Tác giả</th>
                <th>Thể loại</th>
                <th>Số lượng</th>
                <th>Vị trí</th>
                <th>Năm XB</th>
                <th class="text-end">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Books.Any())
            {
                <tr>
                    <td colspan="7" class="text-center py-4">Không tìm thấy dữ liệu phù hợp.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.Books)
                {
                    <tr>
                        <td><strong>@item.Title</strong></td>
                        <td>@item.Author</td>
                        <td><span class="badge rounded-pill text-bg-secondary">@item.Category</span></td>
                        <td>@item.Quantity</td>
                        <td>@item.ShelfLocation</td>
                        <td>@item.PublishYear</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.Id">Chi tiết</a>
                            <a class="btn btn-sm btn-outline-warning" asp-action="Edit" asp-route-id="@item.Id">Sửa</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Xóa</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3" aria-label="Phân trang sách">
        <ul class="pagination justify-content-end mb-0">
            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : string.Empty)">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-searchTerm="@Model.SearchTerm"
                       asp-route-category="@Model.Category"
                       asp-route-sortBy="@Model.SortBy">@i</a>
                </li>
            }
        </ul>
    </nav>
}
