@model BooksIndexViewModel
@{
    ViewData["Title"] = "Danh sách sách";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Danh sách sách</h2>
    <a class="btn btn-success" asp-action="Create">+ Thêm sách mới</a>
</div>

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-md-6">
        <input
            type="text"
            name="searchTerm"
            value="@Model.SearchTerm"
            class="form-control"
            placeholder="Tìm theo tên sách hoặc tác giả..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
    </div>
</form>

<p class="text-muted">Tổng số kết quả: <strong>@Model.TotalItems</strong></p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Tên sách</th>
            <th>Tác giả</th>
            <th>Thể loại</th>
            <th>Số lượng</th>
            <th>Vị trí</th>
            <th>Năm XB</th>
            <th class="text-end">Hành động</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Books.Any())
        {
            <tr>
                <td colspan="7" class="text-center">Không tìm thấy dữ liệu phù hợp.</td>
            </tr>
        }
        else
        {
            @foreach (var item in Model.Books)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>@item.Author</td>
                    <td>@item.Category</td>
                    <td>@item.Quantity</td>
                    <td>@item.ShelfLocation</td>
                    <td>@item.PublishYear</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.Id">Chi tiết</a>
                        <a class="btn btn-sm btn-outline-warning" asp-action="Edit" asp-route-id="@item.Id">Sửa</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Xóa</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Phân trang sách">
        <ul class="pagination">
            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : string.Empty)">
                    <a
                        class="page-link"
                        asp-action="Index"
                        asp-route-page="@i"
                        asp-route-searchTerm="@Model.SearchTerm">@i</a>
                </li>
            }
        </ul>
    </nav>
}
