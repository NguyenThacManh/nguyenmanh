@model Book
@{
    ViewData["Title"] = "Chi tiết sách";
}

<h2>Chi tiết sách</h2>
<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Tên sách</dt>
            <dd class="col-sm-9">@Model.Title</dd>
            <dt class="col-sm-3">Tác giả</dt>
            <dd class="col-sm-9">@Model.Author</dd>
            <dt class="col-sm-3">Thể loại</dt>
            <dd class="col-sm-9">@Model.Category</dd>
            <dt class="col-sm-3">Số lượng</dt>
            <dd class="col-sm-9">@Model.Quantity</dd>
            <dt class="col-sm-3">Vị trí</dt>
            <dd class="col-sm-9">@Model.ShelfLocation</dd>
            <dt class="col-sm-3">Năm xuất bản</dt>
            <dd class="col-sm-9">@Model.PublishYear</dd>
            <dt class="col-sm-3">QR Code</dt>
            <dd class="col-sm-9">@Model.QrCode</dd>
            <dt class="col-sm-3">Barcode</dt>
            <dd class="col-sm-9">@Model.Barcode</dd>
        </dl>

        @if (!string.IsNullOrWhiteSpace(Model.CoverImagePath))
        {
            <img src="@Model.CoverImagePath" alt="cover" style="max-height:220px" class="rounded border mt-3" />
        }
    </div>
</div>

<div class="mt-3 d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Sửa</a>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</div>
