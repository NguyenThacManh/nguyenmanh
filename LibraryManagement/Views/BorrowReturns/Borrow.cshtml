@model BorrowTransaction
@{ ViewData["Title"] = "Borrow Book"; }
<h2>Borrow Book</h2>
<form method="post" asp-action="Borrow">
    <div class="mb-2">
        <label class="form-label">Barcode scan</label>
        <input name="barcode" class="form-control" placeholder="Quét/nhập barcode để tự chọn sách" />
    </div>
    <div class="mb-2"><label asp-for="BookId"></label><select asp-for="BookId" asp-items="ViewBag.BookId" class="form-select"></select><span asp-validation-for="BookId" class="text-danger"></span></div>
    <div class="mb-2"><label asp-for="ReaderId"></label><select asp-for="ReaderId" asp-items="ViewBag.ReaderId" class="form-select"></select></div>
    <div class="mb-2"><label asp-for="BorrowDate"></label><input asp-for="BorrowDate" type="date" class="form-control"/></div>
    <div class="mb-2"><label asp-for="DueDate"></label><input asp-for="DueDate" type="date" class="form-control"/></div>
    <button class="btn btn-primary" type="submit">Save</button>
</form>
