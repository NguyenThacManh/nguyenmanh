@model StatisticsViewModel
@{ ViewData["Title"] = "Statistics"; }
<h2>Thống kê</h2>

<div class="row">
    <div class="col-md-6">
        <h5>Sách được mượn nhiều nhất</h5>
        <ul>@foreach (var b in Model.MostBorrowedBooks){<li>@b.BookTitle - @b.BorrowCount lượt</li>}</ul>
    </div>
    <div class="col-md-6">
        <h5>Độc giả mượn nhiều nhất</h5>
        <ul>@foreach (var r in Model.MostActiveReaders){<li>@r.ReaderName - @r.BorrowCount lượt</li>}</ul>
    </div>
</div>

<h5>Sách quá hạn</h5>
<table class="table table-striped">
<thead><tr><th>Sách</th><th>Người đọc</th><th>Hạn trả</th></tr></thead>
<tbody>
@foreach (var o in Model.OverdueBooks)
{
    <tr><td>@o.Book?.Title</td><td>@o.Reader?.FullName</td><td class="text-danger">@o.DueDate.ToString("dd/MM/yyyy")</td></tr>
}
</tbody>
</table>
