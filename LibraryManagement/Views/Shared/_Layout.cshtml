<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản lý thư viện</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-3">
            <div class="container">
                <a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">LibraryManagement</a>
                <div class="navbar-nav flex-wrap">
                    <a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                    <a class="nav-link" asp-controller="Books" asp-action="Index">Books</a>
                    <a class="nav-link" asp-controller="Categories" asp-action="Index">Categories</a>
                    <a class="nav-link" asp-controller="Readers" asp-action="Index">Readers</a>
                    <a class="nav-link" asp-controller="BorrowReturns" asp-action="Index">Borrow / Return</a>
                    <a class="nav-link" asp-controller="Reports" asp-action="Index">Reports</a>
                    <a class="nav-link" asp-controller="Statistics" asp-action="Index">Statistics</a>
                    <a class="nav-link" asp-controller="UserFeatures" asp-action="Index">User Portal</a>
                    <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                    <a class="nav-link" asp-controller="Account" asp-action="Register">Register</a>
                    <a class="nav-link" asp-controller="Account" asp-action="Logout">Logout</a>
                </div>
            </div>
        </nav>
    </header>

    <div class="container pb-3">
        @if (TempData["Message"] is string message)
        {
            <div class="alert alert-success">@message</div>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
